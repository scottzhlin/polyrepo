{
  "name": "agentic-polyglot-starter",
  "version": "0.1.0",
  "private": true,
  "description": "AI coding friendly polyglot monorepo starter",
  "type": "module",
  "scripts": {
    "test": "node --test packages/*/test/*.test.js apps/*/test/*.test.js",
    "build:web": "node apps/web/src/main.js > .dev/web/index.html",
    "docs:check": "python3 tools/docs/check-markdown-links.py",
    "template:check": "python3 tools/template/check-business-leaks.py"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
