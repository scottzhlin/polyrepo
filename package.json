{
  "name": "polyrepo",
  "version": "0.1.0",
  "private": true,
  "description": "AI coding friendly polyglot monorepo template for Go and TypeScript teams",
  "type": "module",
  "scripts": {
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts tools/*/test/*.test.ts",
    "build:web": "node apps/web/src/main.ts > .dev/web/index.html",
    "build:h5": "node apps/h5/src/main.ts > .dev/h5/index.html",
    "create:repo": "node tools/create-repo/src/main.ts",
    "docs:check": "python3 tools/docs/check-markdown-links.py",
    "template:check": "python3 tools/template/check-business-leaks.py"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
