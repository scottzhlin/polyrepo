{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Coding Polyglot Monorepo Template API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/meta": {
      "get": {
        "summary": "Service metadata",
        "responses": {
          "200": {
            "description": "Service metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["service", "version", "time"],
                  "properties": {
                    "service": { "type": "string" },
                    "version": { "type": "string" },
                    "time": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/healthz": {
      "get": {
        "summary": "Admin health check",
        "responses": {
          "200": {
            "description": "Admin service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "surface"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "surface": { "type": "string", "const": "admin" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/v1/meta": {
      "get": {
        "summary": "Admin service metadata",
        "responses": {
          "200": {
            "description": "Admin service metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["service", "surface", "version", "time"],
                  "properties": {
                    "service": { "type": "string" },
                    "surface": { "type": "string", "const": "admin" },
                    "version": { "type": "string" },
                    "time": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
